# Server Port
PORT=3000

# Optional Supabase Integration (Leave empty to use built-in local reactive storage)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-Side Supabase Key (Keep private, never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
